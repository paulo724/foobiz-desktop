{
  "name": "foobiz-desktop",
  "version": "1.3.0",
  "description": "Foobiz Desktop — Totem, KDS e PDV",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "dev:totem": "cross-env FOOBIZ_APP=totem electron .",
    "dev:kds": "cross-env FOOBIZ_APP=kds electron .",
    "dev:pdv": "cross-env FOOBIZ_APP=pdv electron .",
    "build:totem": "cross-env FOOBIZ_APP=totem electron-builder --config electron-builder.totem.config.cjs",
    "build:kds": "cross-env FOOBIZ_APP=kds electron-builder --config electron-builder.kds.config.cjs",
    "build:pdv": "cross-env FOOBIZ_APP=pdv electron-builder --config electron-builder.pdv.config.cjs",
    "build:all": "npm run build:totem && npm run build:kds && npm run build:pdv"
  },
  "dependencies": {
    "bonjour-service": "^1.4.1",
    "electron-log": "^5.2.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.3",
    "koffi": "^3.1.4",
    "node-thermal-printer": "^4.4.1",
    "pusher-js": "^8.5.0",
    "selfsigned": "^5.5.0",
    "serialport": "^12.0.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^39.8.10",
    "electron-builder": "^26.15.7"
  }
}
